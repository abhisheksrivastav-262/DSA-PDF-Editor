# EDITOR — AI PDF Editor Environment Variables
# Copy to .env and fill. API keys are stored server-side only; never exposed via NEXT_PUBLIC.

# OpenAI-compatible AI provider (user-configured via UI or env)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
# Optional extra headers JSON for providers that need it
# AI_EXTRA_HEADERS={"X-Custom-Header":"value"}

# Storage & Database
STORAGE_DIR=./backend/storage
DATABASE_URL=sqlite:///./backend/editor.db

# Security
SECRET_KEY=change-me-to-a-random-secret-in-production

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (Vite) — API base (proxied via vite.config, no key here)
VITE_API_BASE=/api
